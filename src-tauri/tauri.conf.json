{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovelAI 元数据整理工具",
  "version": "0.1.0",
  "identifier": "com.achilng.novelai-metadata-organizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NovelAI 元数据整理工具",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

